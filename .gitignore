data/*
!data/README.md
models/*.pkl
models/*.joblib
venv/
.venv*/
.ipynb_checkpoints/
# Ignore Python cache files, oython jab bhi koi .py file run karta hai to wo automatically __pycache__ folder create kar deta hai jisme compiled bytecode store hota hai, isliye is folder ko ignore karna chahiye.
__pycache__/ 
# Ignore Jupyter Notebook checkpoints, ye bhi automatically create hota hai jab hum notebook run karte hai, isliye isko bhi ignore karna chahiye.
scratch/
model/*.pkl
model/*.joblib
notebooks/model/*.joblib
# MLflow
mlflow_store/
mlruns/
mlartifacts/
*.joblib
*.pkl

# Ignore artifacts generated by the pipeline runs, but keep the joblib files in app_artifacts, isko hum production app ke sath deploy karna chahte hai, isliye isko ignore nahi karenge.
!app_artifacts/*.joblib
pipeline_runs/

#ye sabse impotant hai, ye humare sensitive data ko ignore karta hai, jaise ki database credentials, API keys, etc. isliye isko ignore karna chahiye.
.env

#yeh Mac computer ke liye hai, Mac automatically .DS_Store file create kar deta hai, isliye isko ignore karna chahiye.
.DS_Store

#yeh testing(pytest) or code formatting(ruff) ke liye hai, ye automatically create hota hai jab hum testing or code formatting karte hai, isliye isko ignore karna chahiye.
.pytest_cache/
.ruff_cache/


#agar koi file push ho gyi hai to usko ignore karne ke liye hum git rm --cached <file> command ka use karte hai, isse wo file git ke tracking se remove ho jati hai lekin local machine me rehti hai.
# git sataus se hum ye check kar sakte hai ki kaun kaun si file git ke tracking me hai aur kaun kaun si file git ke tracking me nahi(ignored) hai.
#agar kisi specifically check karna hai ki kon si file ignore ho rahi hai ya nahi to hum git check-ignore -v <file> command ka use karte hai, isse hume pata chal jata hai ki kon si file ignore ho rahi hai aur kon si file ignore nahi ho rahi hai.